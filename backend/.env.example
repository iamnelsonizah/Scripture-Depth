# Application Settings
ENVIRONMENT=development
PROJECT_NAME="ScriptureDepth API"
API_V1_STR=/api/v1

# Supabase / PostgreSQL Connection
# For local development with SQLite, leave as is or use sqlite+aiosqlite:///./scripturedepth.db
# For Supabase production: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./scripturedepth.db

# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# CORS (comma-separated origins or * for all)
BACKEND_CORS_ORIGINS="*"
